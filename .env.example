# Copy to .env.local for local development. Set the same keys in the
# Vercel project "wahnon-website". Never commit real values.

# Required before anyone can sign in to /dive-os.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional canonical URL, used for metadata. Example: https://example.com
NEXT_PUBLIC_SITE_URL=

# Credentials sign-in. Both must be set, or this method stays off.
# Generate the hash without saving the password in shell history:
#   node --input-type=module -e "import { hash } from 'bcryptjs'; let s=''; process.stdin.setEncoding('utf8'); process.stdin.on('data', d => s += d); process.stdin.on('end', async () => console.log(await hash(s.replace(/\n$/,''), 12)))"
# Then type the password and press Ctrl-D.
ADMIN_EMAIL=
# In a .env file, escape each $ as \$. In the Vercel dashboard, paste the hash
# with the dollar signs and without backslashes.
ADMIN_PASSWORD_HASH=

# GitHub sign-in, limited to an allowlist. All three must be set.
# Callback URL: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_LOGINS=

# Optional. Auth.js uses the request host when this is unset (trustHost is on).
# Set it if preview deployments should sign in against a fixed URL.
AUTH_URL=

# Optional contact form delivery. HTTPS only. See the README.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
